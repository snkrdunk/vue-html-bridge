{
  "$schema": "https://raw.githubusercontent.com/markuplint/markuplint/main/config.schema.json",
  "extends": ["markuplint:recommended-static-html"],
  "parser": {
    "\\.vue$": "@markuplint/vue-parser"
  },
  "rules": {
    "no-duplicate-id": true
  },
  "nodeRules": [
    {
      "selector": "img",
      "rules": {
        "require-attr": ["alt"]
      }
    }
  ],
  "overrides": {
    "**/*.__vue_html_bridge__/**/*.html": {
      "rules": {
        "require-doctype": false
      }
    },
    "**/*.vue": {
      "rules": {
        "require-doctype": true
      }
    }
  },
  "excludeFiles": ["**/ignored/**"]
}
