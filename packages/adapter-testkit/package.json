{
  "name": "@vue-html-bridge/adapter-testkit",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "description": "Contract tests, fake adapter, and fixtures for validator-api adapters.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fake": {
      "types": "./dist/fake.d.ts",
      "import": "./dist/fake.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@vue-html-bridge/validator-api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "vitest": "4.1.11"
