{
  "name": "@vue-html-bridge/settings",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Shared settings schema, defaults, resolution, and decomposition for both hosts.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "generate-schema": "node scripts/generate-schema.mjs"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "vitest": "4.1.11",
    "vue-html-bridge": "workspace:*"
  }
}
