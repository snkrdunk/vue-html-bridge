{
  "name": "@vue-html-bridge/cli",
  "version": "0.1.0",
  "license": "MIT",
  "description": "One-shot command-line client for vue-html-bridge analysis.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "vue-html-bridge": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@vue-html-bridge/analyzer": "workspace:*",
    "@vue-html-bridge/adapter-loader": "workspace:*",
    "@vue-html-bridge/adapter-markuplint": "workspace:*",
    "@vue-html-bridge/validator-api": "workspace:*",
    "@vue-html-bridge/settings": "workspace:*",
    "minimatch": "10.2.6"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@vue-html-bridge/adapter-testkit": "workspace:*",
    "@vue-html-bridge/language-server": "workspace:*",
    "vitest": "4.1.11",
    "vscode-jsonrpc": "9.0.1",
    "vscode-languageserver": "10.1.0",
    "vscode-uri": "3.1.0"
  }
}
